#pragma kernel CSInitializeOctree
#pragma kernel CSSelectLOD
#pragma kernel CSBalanceOctree2To1
#pragma kernel CSApplyLODRequests
#pragma kernel CSApplyMergeRequests
#pragma kernel CSResetActiveLeaves
#pragma kernel CSRebuildActiveLeaves
#pragma kernel CSResetLodStats
#pragma kernel CSCalculateLodStats
#pragma kernel CSBuildNeighborLOD
#pragma kernel CSBuildNeighborTopology
#pragma kernel CSBuildTransitionTopology

#pragma kernel CSResetLeafMesh
#pragma kernel CSCountLeafMeshVertices
#pragma kernel CSScanLeafMeshVertexOffsets
#pragma kernel CSBuildVertices
#pragma kernel CSCountLeafMeshIndices
#pragma kernel CSScanLeafMeshIndexOffsets
#pragma kernel CSBuildXFaces
#pragma kernel CSBuildYFaces
#pragma kernel CSBuildZFaces
#pragma kernel CSBuildLeafBoundaryFaces
#pragma kernel CSFinalizeLeafMesh

#include "VoxelDensityTypes.hlsl"
#include "VoxelDensityMath.hlsl"
#include "VoxelDensityDensity.hlsl"
#include "VoxelDensityQEF.hlsl"
#include "VoxelDensityTopology.hlsl"
#include "VoxelOctree.hlsl"
#include "VoxelDensityMesh.hlsl"


// ============================================================
// MESH KERNEL WRAPPERS
// ============================================================
//
// Octree/topology kernels are already defined by the included
// HLSL files, so they must NOT be redeclared here.
//
// Mesh kernels are implemented in VoxelDensityMeshV1.hlsl and
// exposed here with the exact argument signatures expected by
// those implementations.
// ============================================================


[numthreads(128, 1, 1)]
void CSResetLeafMesh(uint3 id : SV_DispatchThreadID)
{
    CSResetLeafMeshImpl(id);
}


// ============================================================
// COUNT VERTICES
// ============================================================

[numthreads(128, 1, 1)]
void CSCountLeafMeshVertices(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    CSCountLeafMeshVerticesImpl(
        groupId,
        groupThreadId
    );
}


// ============================================================
// SCAN VERTEX OFFSETS
// ============================================================

[numthreads(1, 1, 1)]
void CSScanLeafMeshVertexOffsets(
    uint3 id : SV_DispatchThreadID)
{
    CSScanLeafMeshVertexOffsetsImpl(id);
}


// ============================================================
// BUILD VERTICES
// ============================================================

[numthreads(128, 1, 1)]
void CSBuildVertices(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    CSBuildVerticesImpl(
        groupId,
        groupThreadId
    );
}


// ============================================================
// COUNT INDICES
// ============================================================

[numthreads(128, 1, 1)]
void CSCountLeafMeshIndices(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
