#pragma kernel CSInitializeOctree
#pragma kernel CSSelectLOD
#pragma kernel CSBalanceOctree2To1
#pragma kernel CSApplyLODRequests
#pragma kernel CSApplyMergeRequests
#pragma kernel CSResetActiveLeaves
#pragma kernel CSRebuildActiveLeaves
#pragma kernel CSResetLodStats
#pragma kernel CSCalculateLodStats
#pragma kernel CSBuildNeighborLOD
#pragma kernel CSBuildNeighborTopology

#pragma kernel CSResetLeafMesh
#pragma kernel CSCountLeafMeshVertices
#pragma kernel CSCountTransitionLeafMeshVertices
#pragma kernel CSScanLeafMeshVertexOffsets
#pragma kernel CSBuildVertices
#pragma kernel CSBuildTransitionVertices
#pragma kernel CSFinalizeLeafMesh

#include "VoxelDensityTypes.hlsl"
#include "VoxelDensityMath.hlsl"
#include "VoxelDensityDensity.hlsl"
#include "VoxelOctree.hlsl"
#include "VoxelDensityMeshMCTransvoxel.hlsl"

[numthreads(128, 1, 1)]
void CSResetLeafMesh(uint3 id : SV_DispatchThreadID)
{
    CSResetLeafMeshImpl(id);
}

[numthreads(128, 1, 1)]
void CSCountLeafMeshVertices(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    CSCountLeafMeshVerticesImpl(groupId, groupThreadId);
}

[numthreads(128, 1, 1)]
void CSCountTransitionLeafMeshVertices(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    CSCountTransitionLeafMeshVerticesImpl(groupId, groupThreadId);
}

[numthreads(1, 1, 1)]
void CSScanLeafMeshVertexOffsets(uint3 id : SV_DispatchThreadID)
{
    CSScanLeafMeshVertexOffsetsImpl(id);
}

[numthreads(128, 1, 1)]
void CSBuildVertices(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    CSBuildVerticesImpl(groupId, groupThreadId);
}

[numthreads(128, 1, 1)]
void CSBuildTransitionVertices(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    CSBuildTransitionVerticesImpl(groupId, groupThreadId);
}

[numthreads(1, 1, 1)]
void CSFinalizeLeafMesh(uint3 id : SV_DispatchThreadID)
{
    CSFinalizeLeafMeshImpl(id);
}
