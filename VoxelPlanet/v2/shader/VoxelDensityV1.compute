    CSCountLeafMeshIndicesImpl(
        groupId,
        groupThreadId
    );
}


// ============================================================
// SCAN INDEX OFFSETS
// ============================================================

[numthreads(1, 1, 1)]
void CSScanLeafMeshIndexOffsets(
    uint3 id : SV_DispatchThreadID)
{
    CSScanLeafMeshIndexOffsetsImpl(id);
}


